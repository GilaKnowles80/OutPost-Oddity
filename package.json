{
  "name": "outpost-oddity",
  "version": "1.0.0",
  "private": true,
  "description": "A comedic episodic sci-fi text and puzzle adventure game built with Next.js, Auth.js, and Neon.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cap:init": "npx @capacitor/cli init",
    "cap:add:android": "npx @capacitor/cli add android",
    "cap:add:ios": "npx @capacitor/cli add ios",
    "cap:sync": "npx @capacitor/cli sync",
    "cap:open:android": "npx @capacitor/cli open android",
    "cap:open:ios": "npx @capacitor/cli open ios",
    "cap:build:android": "npm run build && npx cap copy && npx cap sync android",
    "cap:build:ios": "npm run build && npx cap copy && npx cap sync ios",
    "pwa:generate-icons": "node -e \"require('fs').copyFileSync('public/logo.png','public/icon-192.png');require('fs').copyFileSync('public/logo.png','public/icon-512.png');require('fs').copyFileSync('public/logo.png','public/apple-touch-icon.png');console.log('PWA icons generated from logo.png')\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@neondatabase/serverless": "^0.9.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.64.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-stdlib": "^2.36.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^0.2.4",
    "postcss": "^8.4.0",
    "rimraf": "^4.1.4",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "tmp": "^0.2.3",
    "cross-spawn": "^7.0.5",
    "minimatch": "^11.0.1",
    "ajv": "^8.17.1",
    "glob": "^11.0.0"
  }
}
